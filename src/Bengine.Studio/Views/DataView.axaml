<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Bengine.Studio.ViewModels"
             xmlns:c="clr-namespace:Bengine.Studio.Controls"
             x:Class="Bengine.Studio.Views.DataView"
             x:DataType="vm:DataDocumentViewModel">
  <UserControl.Styles>
    <Style Selector="DataGridRow.inserted"><Setter Property="Background" Value="#14321f" /></Style>
    <Style Selector="DataGridRow.deleted"><Setter Property="Background" Value="#3a1d1d" /><Setter Property="Opacity" Value="0.65" /></Style>
    <Style Selector="TextBox.clause">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="toolbar" BorderThickness="0,0,0,1"
            BorderBrush="{Binding AccentColor, Converter={x:Static c:Converters.AccentBrush}}">
      <WrapPanel>
        <Button Classes="tool" Content="⟳" ToolTip.Tip="Reload (F5)" Command="{Binding RefreshCommand}" />
        <Button Classes="tool" Content="⏮" ToolTip.Tip="First page" Command="{Binding FirstPageCommand}" />
        <Button Classes="tool" Content="‹" ToolTip.Tip="Previous page" Command="{Binding PreviousPageCommand}" />
        <Button Classes="tool" Content="›" ToolTip.Tip="Next page" Command="{Binding NextPageCommand}" />
        <Button Classes="tool" Content="⏭" ToolTip.Tip="Last page" Command="{Binding LastPageCommand}" />
        <Border Classes="sep" />
        <Button Classes="tool" Content="＋" ToolTip.Tip="Add row (Alt+Insert)" Command="{Binding AddRowCommand}" IsEnabled="{Binding CanEdit}" />
        <Button Classes="tool" Content="⧉" ToolTip.Tip="Clone row (Ctrl+D)" Command="{Binding CloneRowCommand}" IsEnabled="{Binding CanEdit}" />
        <Button Classes="tool" Content="－" ToolTip.Tip="Delete rows (Ctrl+Delete)" Command="{Binding DeleteRowsCommand}" IsEnabled="{Binding CanEdit}" />
        <Border Classes="sep" />
        <Button Classes="primary" Content="Submit" ToolTip.Tip="Submit pending changes (Ctrl+Enter)" Command="{Binding SubmitCommand}" IsEnabled="{Binding HasPending}" Margin="0,0,4,0" />
        <Button Classes="ghost" Content="Preview…" ToolTip.Tip="Show the SQL of the pending changes" Command="{Binding PreviewChangesCommand}" IsEnabled="{Binding HasPending}" Margin="0,0,4,0" />
        <Button Classes="ghost" Content="Revert" ToolTip.Tip="Discard all pending changes (Ctrl+Alt+Z)" Command="{Binding RevertAllCommand}" IsEnabled="{Binding HasPending}" Margin="0,0,4,0" />
        <Border Background="#1d3557" CornerRadius="3" Padding="6,1" IsVisible="{Binding HasPending}" VerticalAlignment="Center">
          <TextBlock FontSize="11" Foreground="#9cc4ff" Text="{Binding PendingCount, StringFormat='{}{0} pending'}" />
        </Border>
        <CheckBox Content="Auto-submit" IsChecked="{Binding AutoSubmit}" Margin="8,0,0,0" ToolTip.Tip="Submit each edit as soon as the cell is left" IsEnabled="{Binding CanEdit}" />
        <Border Classes="sep" />
        <ToggleButton Classes="tool" Content="⇅ Record" IsChecked="{Binding IsRecordView}" ToolTip.Tip="Show the selected row as a vertical record" />
        <Button Classes="tool" Content="⌨" ToolTip.Tip="Open this query in a console" Command="{Binding OpenInConsoleCommand}" />
        <Button Classes="ghost" Content="Export ▾" Margin="4,0,0,0">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="CSV…" Command="{Binding ExportCommand}" CommandParameter="csv" />
              <MenuItem Header="TSV…" Command="{Binding ExportCommand}" CommandParameter="tsv" />
              <MenuItem Header="JSON…" Command="{Binding ExportCommand}" CommandParameter="json" />
              <MenuItem Header="Markdown…" Command="{Binding ExportCommand}" CommandParameter="markdown" />
              <MenuItem Header="{Binding InsertLabel, StringFormat='{}{0}…'}" Command="{Binding ExportCommand}" CommandParameter="sql-insert" />
              <MenuItem Header="Excel (.xlsx)…" Command="{Binding ExportCommand}" CommandParameter="xlsx" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <TextBox Width="170" Margin="8,0,0,0" Watermark="Find in page…" Text="{Binding FindText}" />
      </WrapPanel>
    </Border>

    <!-- WHERE / ORDER BY -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="8,5">
      <Grid ColumnDefinitions="Auto,3*,Auto,2*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding WhereLabel}" Foreground="#c792ea" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Column="1" Classes="clause" x:Name="Where" Text="{Binding WhereText}" Watermark="{Binding WhereHint}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyFilterCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <TextBlock Grid.Column="2" Text="{Binding OrderByLabel}" Foreground="#c792ea" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,8,0" />
        <TextBox Grid.Column="3" Classes="clause" Text="{Binding OrderByText}" Watermark="{Binding OrderByHint}">
          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyFilterCommand}" /></TextBox.KeyBindings>
        </TextBox>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
          <Button Classes="ghost" Content="Apply" Command="{Binding ApplyFilterCommand}" />
          <Button Classes="tool" Content="✕" ToolTip.Tip="Clear filter and ordering" Command="{Binding ClearFilterCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pager / status -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="10,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="dim" Text="Rows/page" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Classes="dim" Text="{Binding PageInfo}" VerticalAlignment="Center" />
          <TextBlock Classes="dim mono" FontSize="12" Text="{Binding Aggregates}" VerticalAlignment="Center" IsVisible="{Binding Aggregates, Converter={x:Static c:Converters.HasText}}" />
          <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760"
                     Foreground="{Binding IsError, Converter={x:Static c:Converters.StatusBrush}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto">
      <DataGrid Grid.Column="0" x:Name="Grid" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                AutoGenerateColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True" SelectionMode="Extended"
                CanUserReorderColumns="True" HeadersVisibility="All" />
      <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource LineSoft}" IsVisible="{Binding IsRecordView}" />
      <Border Grid.Column="2" Width="380" Background="{StaticResource Panel}" IsVisible="{Binding IsRecordView}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Record" FontWeight="SemiBold" Margin="10,8" />
          <DataGrid ItemsSource="{Binding Record}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="{Binding !CanEdit}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Column" Binding="{Binding Name}" IsReadOnly="True" Width="130" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=TwoWay}" Width="*" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="90" Foreground="#5d6a7d" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <ProgressBar Grid.ColumnSpan="3" IsIndeterminate="True" VerticalAlignment="Top" Height="2" MinHeight="2" IsVisible="{Binding IsBusy}" />
    </Grid>
  </DockPanel>
</UserControl>
