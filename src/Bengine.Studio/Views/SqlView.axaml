<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Bengine.Studio.ViewModels"
             xmlns:c="clr-namespace:Bengine.Studio.Controls"
             x:Class="Bengine.Studio.Views.SqlView"
             x:DataType="vm:SqlDocumentViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar" Padding="14,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost" Content="Copy" Click="OnCopy" IsEnabled="{Binding Sql, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Button Classes="ghost" Content="Open in Query Tool" Click="OnOpenInQuery" IsEnabled="{Binding Sql, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:IconView Kind="{Binding BreadcrumbKind}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Breadcrumb}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Panel>
      <c:SqlEditor x:Name="Code" IsReadOnly="True" HighlightStatement="False" />
      <TextBlock Text="{Binding Message}" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Panel>
  </DockPanel>
</UserControl>
