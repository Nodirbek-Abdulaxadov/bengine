<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bengine.Studio.ViewModels"
        xmlns:v="clr-namespace:Bengine.Studio.Views"
        xmlns:c="clr-namespace:Bengine.Studio.Controls"
        x:Class="Bengine.Studio.Views.MainWindow"
        x:DataType="vm:ExplorerViewModel"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        FontSize="13"
        Background="{StaticResource Bg}"
        Icon="/Assets/bengine-studio.png"
        Title="Bengine Data Studio">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:PropertiesDocumentViewModel"><v:PropertiesView /></DataTemplate>
    <DataTemplate DataType="vm:SqlDocumentViewModel"><v:SqlView /></DataTemplate>
    <DataTemplate DataType="vm:DataDocumentViewModel"><v:DataView /></DataTemplate>
    <DataTemplate DataType="vm:QueryDocumentViewModel"><v:QueryView /></DataTemplate>
    <DataTemplate DataType="vm:SchemaCompareViewModel"><v:SchemaCompareView /></DataTemplate>
    <DataTemplate DataType="vm:DiagramDocumentViewModel"><v:DiagramView /></DataTemplate>
    <DataTemplate DataType="vm:ActivityDocumentViewModel"><v:ActivityView /></DataTemplate>
    <DataTemplate DataType="vm:DataCompareViewModel"><v:DataCompareView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="TreeView#Tree TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" x:DataType="vm:TreeItemViewModel" />
      <Setter Property="IsVisible" Value="{Binding IsVisible}" x:DataType="vm:TreeItemViewModel" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TreeView#FileTree TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" x:DataType="vm:FileItem" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- Quick Documentation (Ctrl+Q): wider than Fluent's 456px flyout limit, no horizontal scrolling. -->
    <Style Selector="FlyoutPresenter.quickdoc">
      <Setter Property="MaxWidth" Value="640" />
      <Setter Property="MaxHeight" Value="620" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="TabControl.side > TabItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TabControl.workspace > TabItem">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#11161e" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="10,4">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="faint" Text="{Binding StorePath}" />
        <TextBlock Classes="dim" Text="{Binding Status}" />
      </DockPanel>
    </Border>

    <Grid x:Name="Body" ColumnDefinitions="340,4,*">
      <TabControl Grid.Column="0" Classes="side" x:Name="SidePanels" Padding="0" Background="{StaticResource Panel}">
      <!-- Object Explorer -->
      <TabItem Header="Database">
      <DockPanel Background="{StaticResource Panel}">
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="6">
          <DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="tool" Content="＋" ToolTip.Tip="New data source" Command="{Binding RegisterServerCommand}" />
              <Button Classes="tool" Content="⇩" ToolTip.Tip="Import from pgAdmin / DataGrip" Command="{Binding ImportPgAdminCommand}" />
              <Button Classes="tool" Content="⟳" ToolTip.Tip="Refresh (Ctrl+F5)" Command="{Binding RefreshCommand}" />
              <Button Classes="tool" Content="⌨" ToolTip.Tip="Query console (Ctrl+Shift+Q)" Command="{Binding QueryToolCommand}" />
              <Button Classes="tool" Content="⊟" ToolTip.Tip="Collapse all" Click="OnCollapseAll" />
              <Button Classes="tool" Content="⟲" ToolTip.Tip="Query history (Ctrl+Alt+E)" Command="{Binding ShowHistoryCommand}" />
              <Button Classes="tool" Content="⌕" ToolTip.Tip="Go to object (Ctrl+N)" Click="OnGoTo" />
              <Button Classes="tool" Content="⇄" ToolTip.Tip="Compare schemas" Command="{Binding CompareCommand}" />
            </StackPanel>

          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
          <TextBox x:Name="TreeFilter" Text="{Binding FilterText}" Watermark="Filter loaded objects…  (Ctrl+F)" MinHeight="28" Padding="8,4" />
        </Border>

        <Panel>
          <TreeView x:Name="Tree"
                    ItemsSource="{Binding Roots}"
                    SelectedItem="{Binding SelectedItem}"
                    Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Padding="0,4">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:TreeItemViewModel" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" Height="22" Background="{Binding AccentColor, Converter={x:Static c:Converters.AccentTint}}">
                  <Border Width="3" Height="16" CornerRadius="1" VerticalAlignment="Center" Background="{Binding AccentColor, Converter={x:Static c:Converters.AccentBrush}}"
                          IsVisible="{Binding AccentColor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <ContentControl Content="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding !IsPlaceholder}" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                             Classes.dim="{Binding IsPlaceholder}"
                             FontStyle="{Binding IsPlaceholder, Converter={x:Static c:Converters.ItalicIfTrue}}"
                             Foreground="{Binding IsError, Converter={x:Static c:Converters.ErrorBrush}}" />
                  <TextBlock Text="{Binding CountText}" Classes="faint" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding CountText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{Binding Detail}" Classes="faint" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="🔒" FontSize="10" VerticalAlignment="Center" ToolTip.Tip="Read-only" IsVisible="{Binding IsReadOnlyServer}" />
                  <ProgressBar IsIndeterminate="True" Width="40" Height="3" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <!-- Speed search: typing in the tree jumps to the first matching row. -->
          <Border x:Name="SpeedSearchBox" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8,2" Padding="8,3" CornerRadius="3"
                  Background="#25303f" BorderBrush="#3d4b5f" BorderThickness="1" IsVisible="False">
            <TextBlock x:Name="SpeedSearchText" Classes="mono" FontSize="12" />
          </Border>

          <StackPanel Spacing="10" Margin="18" IsVisible="{Binding !HasServers}">
            <TextBlock Classes="dim" TextWrapping="Wrap" Text="No data sources yet." />
            <Button Classes="primary" Content="New Data Source" Command="{Binding RegisterServerCommand}" />
            <Button Classes="ghost" Content="Import from pgAdmin / DataGrip" Command="{Binding ImportPgAdminCommand}" />
          </StackPanel>
        </Panel>
      </DockPanel>
      </TabItem>

      <!-- SQL files: the project folder and scratches -->
      <TabItem Header="Files">
        <DockPanel Background="{StaticResource Panel}" DataContext="{Binding FilesPanel}" x:DataType="vm:FilesViewModel">
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="12,6,6,6">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                <Button Classes="tool" Content="＋" ToolTip.Tip="New SQL file" Command="{Binding NewFileCommand}" />
                <Button Classes="tool" Content="⇪" ToolTip.Tip="Open a SQL file…" Command="{Binding OpenFileCommand}" />
                <Button Classes="tool" Content="✎" ToolTip.Tip="New scratch file" Command="{Binding NewScratchCommand}" />
                <Button Classes="tool" Content="▤" ToolTip.Tip="Choose the project folder" Command="{Binding ChooseFolderCommand}" />
                <Button Classes="tool" Content="⟳" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}" />
              </StackPanel>
              <TextBlock Text="Files" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="faint" FontSize="11.5" Margin="12,6" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
          <TreeView x:Name="FileTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}" Background="Transparent" Padding="0,2"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:FileItem" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" Height="22" ToolTip.Tip="{Binding Path}">
                  <TextBlock Text="{Binding Glyph}" Classes="dim" Width="12" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="{Binding IsDirectory, Converter={x:Static c:Converters.BoldIfTrue}}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" Background="{StaticResource LineSoft}" ResizeDirection="Columns" />

      <!-- Workspace: editor tabs, or hints when none is open -->
      <StackPanel Grid.Column="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasTabs}">
        <TextBlock Text="Double-click a table to open its data" Classes="dim" FontSize="15" HorizontalAlignment="Center" />
        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Center">
          <Grid.Styles>
            <Style Selector="TextBlock"><Setter Property="Margin" Value="8,3" /></Style>
          </Grid.Styles>
          <TextBlock Grid.Row="0" Text="Query console" Classes="dim" HorizontalAlignment="Right" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Ctrl+Shift+Q" Classes="mono" Foreground="#82aaff" />
          <TextBlock Grid.Row="1" Text="Go to object" Classes="dim" HorizontalAlignment="Right" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+N" Classes="mono" Foreground="#82aaff" />
          <TextBlock Grid.Row="2" Text="Find action" Classes="dim" HorizontalAlignment="Right" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+Shift+A" Classes="mono" Foreground="#82aaff" />
          <TextBlock Grid.Row="3" Text="Quick documentation" Classes="dim" HorizontalAlignment="Right" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl+Q" Classes="mono" Foreground="#82aaff" />
          <TextBlock Grid.Row="4" Text="Go to DDL" Classes="dim" HorizontalAlignment="Right" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="Ctrl+B" Classes="mono" Foreground="#82aaff" />
          <TextBlock Grid.Row="5" Text="Recent queries" Classes="dim" HorizontalAlignment="Right" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Ctrl+Alt+E" Classes="mono" Foreground="#82aaff" />
        </Grid>
      </StackPanel>
      <TabControl Grid.Column="2" Classes="workspace" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}" Padding="0" Background="{StaticResource Bg}"
                  IsVisible="{Binding HasTabs}">
        <TabControl.ItemTemplate>
          <DataTemplate DataType="vm:DocumentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="7" ToolTip.Tip="{Binding ToolTip}">
              <Border Width="3" Height="14" CornerRadius="1" VerticalAlignment="Center" Background="{Binding AccentColor, Converter={x:Static c:Converters.AccentBrush}}"
                      IsVisible="{Binding AccentColor, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <c:IconView Kind="{Binding IconKind}" IsVisible="{Binding IconKind, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Classes="tool" Content="✕" FontSize="10" Padding="4,1" MinWidth="0" VerticalAlignment="Center"
                      IsVisible="{Binding CanClose}" Click="OnCloseTab" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
