<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Bengine.Studio.Views.PasswordDialog"
        Title="Connect to Server" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Panel}" FontSize="13">
  <StackPanel>
    <StackPanel Margin="18,16" Spacing="12">
      <TextBlock x:Name="Prompt" TextWrapping="Wrap" />
      <TextBox x:Name="Password" PasswordChar="•" Watermark="Password" />
      <CheckBox x:Name="Save" Content="Save Password" />
      <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
    </StackPanel>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
        <Button Classes="primary" Content="OK" Click="OnOk" IsDefault="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
