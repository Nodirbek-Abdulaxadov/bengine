<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Bengine.Studio.ViewModels"
             xmlns:c="clr-namespace:Bengine.Studio.Controls"
             x:Class="Bengine.Studio.Views.PropertiesView"
             x:DataType="vm:PropertiesDocumentViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar" Padding="14,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:IconView Kind="{Binding BreadcrumbKind}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Breadcrumb}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <Panel>
      <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False"
                HeadersVisibility="Column" CanUserSortColumns="False" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="280" Foreground="#8b98ab" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding Message}" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="20" />
    </Panel>
  </DockPanel>
</UserControl>
