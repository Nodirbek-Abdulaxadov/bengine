<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Bengine.Studio.Views.ImportDialog"
        Title="Import Servers from pgAdmin" Width="680" Height="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Panel}" FontSize="13">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="Cancel" Click="OnCancel" />
          <Button x:Name="ImportButton" Classes="primary" Content="Import" Click="OnImport" />
        </StackPanel>
        <TextBlock Classes="dim" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                   Text="Passwords are not imported — pgAdmin encrypts them. You will be asked on first connect." />
      </DockPanel>
    </Border>
    <TextBlock x:Name="Info" DockPanel.Dock="Top" Classes="dim" Margin="16,12,16,4" TextWrapping="Wrap" />
    <DataGrid x:Name="Grid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" Margin="8">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="Auto" />
        <DataGridTextColumn Header="Host" Binding="{Binding Endpoint}" Width="*" />
        <DataGridTextColumn Header="Database" Binding="{Binding MaintenanceDatabase}" Width="Auto" />
        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="Auto" />
        <DataGridTextColumn Header="" Binding="{Binding State}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
